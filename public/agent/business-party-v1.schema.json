{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Business party card v1",
  "type":"object","additionalProperties":false,"required":["protocol","business"],
  "properties":{
    "protocol":{"const":"business-party/v1"},
    "business":{"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9:_-]{1,128}$"},"name":{"type":"string","minLength":1,"maxLength":100}}}
  }
}
