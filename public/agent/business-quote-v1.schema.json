{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Recipient-specific quotation v1",
  "description":"Portable unsigned quotation. Human verification required. All-inclusive TWD unit prices; no extra fees, tax split, currency or unit conversion.",
  "type":"object","additionalProperties":false,
  "required":["protocol","id","revision","createdAt","issuedAt","validUntil","sender","recipient","currency","pricing","items","total","note"],
  "properties":{
    "protocol":{"const":"business-quote/v1"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9:_-]{1,128}$"},
    "revision":{"type":"integer","minimum":1},
    "createdAt":{"type":"string","format":"date-time"},
    "issuedAt":{"type":"string","format":"date-time"},
    "validUntil":{"type":"string","format":"date-time"},
    "sender":{"$ref":"#/definitions/party"},"recipient":{"$ref":"#/definitions/party"},
    "currency":{"const":"TWD"},"pricing":{"const":"all-inclusive-unit"},
    "items":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["sku","name","unit","qty","unitPrice"],"properties":{
      "sku":{"type":"string","pattern":"^[A-Za-z0-9:_-]{1,128}$"},
      "name":{"type":"string","minLength":1,"maxLength":200},
      "unit":{"type":"string","minLength":1,"maxLength":30},
      "qty":{"type":"number","minimum":0.001,"maximum":1000000000,"multipleOf":0.001},
      "unitPrice":{"type":"number","minimum":0,"maximum":1000000000,"multipleOf":0.01}
    }}},
    "total":{"type":"number","minimum":0,"maximum":1000000000,"multipleOf":0.01},
    "note":{"type":"string","maxLength":500}
  },
  "definitions":{"party":{"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9:_-]{1,128}$"},"name":{"type":"string","minLength":1,"maxLength":100}}}}
}
