{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pos:migration-batch:v1",
  "title": "Original source file batch for local owner review",
  "$comment": "No business authority. The application additionally verifies UTF-8 byte limits, raw-only batch identity, known-value repairs, source custody, permissions and actual original history. A schema is not a receipt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "pos-migration-batch/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^batch-[a-f0-9]{48}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 128
        },
        "company": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "system",
        "company"
      ]
    },
    "currency": {
      "enum": [
        "",
        "TWD"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "csv"
              },
              "file": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 80000
                  },
                  "delimiter": {
                    "enum": [
                      "",
                      ",",
                      "\t",
                      ";"
                    ]
                  }
                },
                "required": [
                  "name",
                  "text",
                  "delimiter"
                ]
              },
              "sheets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sheetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "headerRow": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048576
                    },
                    "plan": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "entity": {
                          "enum": [
                            "",
                            "products",
                            "suppliers",
                            "customers",
                            "opening-receivables",
                            "opening-payables"
                          ]
                        },
                        "externalId": {
                          "type": "integer",
                          "minimum": -1,
                          "maximum": 99
                        },
                        "mapping": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "string",
                            "maxLength": 128
                          }
                        },
                        "unit": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "repairs": {
                          "type": "array",
                          "maxItems": 1000,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "row": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4999
                              },
                              "column": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 99
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 2048
                              }
                            },
                            "required": [
                              "row",
                              "column",
                              "value"
                            ]
                          }
                        },
                        "amountFormat": {
                          "enum": [
                            "decimal-dot",
                            "grouped-dot",
                            "grouped-comma"
                          ]
                        },
                        "dateFormat": {
                          "enum": [
                            "iso",
                            "ymd-slash",
                            "dmy",
                            "mdy"
                          ]
                        }
                      },
                      "required": [
                        "entity",
                        "externalId",
                        "mapping",
                        "unit",
                        "repairs",
                        "amountFormat",
                        "dateFormat"
                      ]
                    }
                  },
                  "required": [
                    "sheetId",
                    "headerRow",
                    "plan"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "file",
              "sheets"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "xlsx"
              },
              "file": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "base64": {
                    "type": "string",
                    "maxLength": 160000
                  }
                },
                "required": [
                  "name",
                  "base64"
                ]
              },
              "sheets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sheetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "headerRow": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048576
                    },
                    "plan": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "entity": {
                          "enum": [
                            "",
                            "products",
                            "suppliers",
                            "customers",
                            "opening-receivables",
                            "opening-payables"
                          ]
                        },
                        "externalId": {
                          "type": "integer",
                          "minimum": -1,
                          "maximum": 99
                        },
                        "mapping": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "string",
                            "maxLength": 128
                          }
                        },
                        "unit": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "repairs": {
                          "type": "array",
                          "maxItems": 1000,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "row": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4999
                              },
                              "column": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 99
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 2048
                              }
                            },
                            "required": [
                              "row",
                              "column",
                              "value"
                            ]
                          }
                        },
                        "amountFormat": {
                          "enum": [
                            "decimal-dot",
                            "grouped-dot",
                            "grouped-comma"
                          ]
                        },
                        "dateFormat": {
                          "enum": [
                            "iso",
                            "ymd-slash",
                            "dmy",
                            "mdy"
                          ]
                        }
                      },
                      "required": [
                        "entity",
                        "externalId",
                        "mapping",
                        "unit",
                        "repairs",
                        "amountFormat",
                        "dateFormat"
                      ]
                    }
                  },
                  "required": [
                    "sheetId",
                    "headerRow",
                    "plan"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "file",
              "sheets"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "protocol",
    "id",
    "source",
    "currency",
    "files"
  ]
}
