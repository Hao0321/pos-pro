{
  "name": "POS Pro Agent document drafts",
  "protocol": "pos-document-draft/v1",
  "portableProtocol": "business-document/v1",
  "portableSchema": "/agent/business-document-v1.schema.json",
  "schema": "/agent/document-draft-v1.schema.json",
  "guide": "/llms.txt",
  "context": {
    "surface": "authenticated application browser or desktop preload",
    "method": "window.electronAPI.db.getAgentContext()",
    "authentication": "existing login and paired-device session; no credentials in drafts"
  },
  "delivery": {
    "paste": "快速建單",
    "linkFragment": "agentDraft=<encodeURIComponent(JSON)>"
  },
  "kinds": [
    "sale",
    "restaurant",
    "purchase"
  ],
  "financialDrafts": [
    {
      "protocol": "pos-customer-receipt-draft/v1",
      "schema": "/agent/customer-receipt-draft-v1.schema.json",
      "role": "owner",
      "contextMethod": "window.electronAPI.db.getSalesState()",
      "pasteSurface": "customers",
      "humanReviewRequired": true,
      "moneyMovement": false,
      "linkFragment": false
    },
    {
      "protocol": "pos-supplier-payment-draft/v1",
      "schema": "/agent/supplier-payment-draft-v1.schema.json",
      "role": "owner",
      "contextMethod": "window.electronAPI.db.getSupplierState()",
      "pasteSurface": "suppliers",
      "humanReviewRequired": true,
      "approvalPolicy": "store-controlled",
      "moneyMovement": false,
      "linkFragment": false
    },
    {
      "protocol": "pos-purchase-invoice-draft/v1",
      "schema": "/agent/purchase-invoice-draft-v1.schema.json",
      "role": "owner",
      "contextMethod": "Copy task instructions from the authenticated selected purchase invoice form",
      "pasteSurface": "purchase invoice",
      "humanReviewRequired": true,
      "moneyMovement": false,
      "linkFragment": false
    }
  ],
  "humanReviewRequired": true,
  "moneyMovement": false,
  "arbitraryExecution": false,
  "featurePrice": "free",
  "manifest": "/agent/manifest.json",
  "ordinarySupplierReturnDraft": {
    "protocol": "pos-ordinary-supplier-return-draft/v1",
    "schema": "/agent/ordinary-supplier-return-draft-v1.schema.json",
    "context": "Explicit owner handoff for ordinary non-lot goods return; store, epoch, purchase, relevant stock and selected invoice source",
    "paste": "採購 → 辦理退貨 → 讓 Agent 幫我填",
    "humanReviewRequired": true,
    "automaticMoneyMovement": false,
    "linkFragment": false
  },
  "migrationBatchDraft": {
    "protocol": "pos-migration-batch/v1",
    "schema": "/agent/migration-batch-v1.schema.json",
    "guide": "/agent/guides/batch-migration.txt",
    "manifest": "/agent/manifest.json",
    "humanReviewRequired": true,
    "externalAgentWriteApi": false
  }
}
